---
import Button from "../react/Button";
---

<nav id="site-nav" class="pk-nav">
  <div class="pk-nav__inner">
    <a href="/" class="pk-nav__brand">Joydip Dutta</a>

    <div class="pk-nav__links">
      <a href="/#work" class="pk-nav__link">Work</a>
      <a href="/#services" class="pk-nav__link">Services</a>
      <a href="/#about" class="pk-nav__link">About</a>
      <a href="/#contact" class="pk-nav__link">Contact</a>
    </div>

    <div class="pk-nav__right">
      <button id="nav-cmdk" class="pk-cmdk" type="button" aria-label="Open command palette">
        Search <kbd>⌘K</kbd>
      </button>
      <Button client:load size="sm" href="/#contact">Start a project</Button>
    </div>

    <button
      id="mobile-menu-btn"
      class="pk-mobile-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="pk-mobile-toggle__line"></span>
      <span class="pk-mobile-toggle__line"></span>
      <span class="pk-mobile-toggle__line"></span>
    </button>
  </div>

  <div id="mobile-menu" class="pk-mobile-menu">
    <div class="pk-mobile-menu__inner">
      <div class="pk-mobile-menu__links">
        <a href="/#work" class="pk-mobile-menu__link">Work</a>
        <a href="/#services" class="pk-mobile-menu__link">Services</a>
        <a href="/#about" class="pk-mobile-menu__link">About</a>
        <a href="/#contact" class="pk-mobile-menu__link">Contact</a>
      </div>

      <div class="pk-mobile-menu__actions">
        <button
          id="mobile-nav-cmdk"
          class="pk-mobile-cmdk"
          type="button"
          aria-label="Open command palette"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="pk-mobile-search-icon"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          Search palette
        </button>
        <Button client:load href="/#contact" className="w-full justify-center"
          >Start a project</Button
        >
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    // initNav runs twice on a first load with <ClientRouter /> (inline + astro:page-load),
    // and again after every view transition. Handlers must therefore bind exactly once per
    // DOM node — removeEventListener() with a freshly-created closure removes nothing, which
    // previously left two click handlers on the hamburger so it opened and closed in one tap.
    let scrollHandler = null;

    function bindOnce(el, type, fn, flag) {
      if (!el || el.dataset[flag] === "1") return;
      el.dataset[flag] = "1";
      el.addEventListener(type, fn);
    }

    function openCmdPalette() {
      window.dispatchEvent(new CustomEvent("pk:cmd-open"));
    }

    function initNav() {
      const nav = document.getElementById("site-nav");
      if (!nav) return;

      const onScroll = () => {
        if (window.scrollY > 24) nav.classList.add("scrolled");
        else nav.classList.remove("scrolled");
      };
      onScroll();
      // The listener closes over `nav`, which is a new node after each swap — drop the
      // previous one rather than stacking handlers pointed at a detached element.
      if (scrollHandler) window.removeEventListener("scroll", scrollHandler);
      scrollHandler = onScroll;
      window.addEventListener("scroll", scrollHandler, { passive: true });

      bindOnce(document.getElementById("nav-cmdk"), "click", openCmdPalette, "pkCmdBound");

      const toggleBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      if (!toggleBtn || !mobileMenu) return;

      const setMenu = (open) => {
        nav.classList.toggle("mobile-open", open);
        toggleBtn.setAttribute("aria-expanded", open ? "true" : "false");
        document.body.style.overflow = open ? "hidden" : "";
      };

      // A swap can land mid-open; start every page closed and never leave body scroll locked.
      setMenu(false);

      bindOnce(
        toggleBtn,
        "click",
        () => setMenu(!nav.classList.contains("mobile-open")),
        "pkToggleBound"
      );

      mobileMenu.querySelectorAll(".pk-mobile-menu__link").forEach((link) => {
        bindOnce(link, "click", () => setMenu(false), "pkCloseBound");
      });

      bindOnce(
        document.getElementById("mobile-nav-cmdk"),
        "click",
        () => {
          setMenu(false);
          openCmdPalette();
        },
        "pkMobileCmdBound"
      );

      if (!document.documentElement.dataset.pkNavKeys) {
        document.documentElement.dataset.pkNavKeys = "1";
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            const current = document.getElementById("site-nav");
            const btn = document.getElementById("mobile-menu-btn");
            if (current && current.classList.contains("mobile-open")) {
              current.classList.remove("mobile-open");
              if (btn) btn.setAttribute("aria-expanded", "false");
              document.body.style.overflow = "";
            }
          }
        });
      }
    }

    initNav();
    document.addEventListener("astro:page-load", initNav);
  })();
</script>
